-- A scheduled block of work inside a project.
--
-- The zone is stored alongside the instants rather than assumed from the device: a
-- destination wedding booked from home, and a shoot that straddles a daylight-saving
-- boundary, both break when local time is treated as unambiguous.
CREATE TABLE session (
    id               TEXT    NOT NULL PRIMARY KEY,
    studio_id        TEXT    NOT NULL,
    project_id       TEXT    NOT NULL,
    title            TEXT    NOT NULL,
    kind             TEXT    NOT NULL,
    status           TEXT    NOT NULL,
    starts_at        INTEGER NOT NULL,
    ends_at          INTEGER NOT NULL,
    time_zone_id     TEXT    NOT NULL,
    location_name    TEXT,
    location_address TEXT,
    call_time        INTEGER,
    notes            TEXT,
    created_at       INTEGER NOT NULL,
    updated_at       INTEGER NOT NULL,
    deleted_at       INTEGER,
    version          INTEGER NOT NULL DEFAULT 1,
    -- Where the shoot is, for computing the light. Null for anything indoors, which is
    -- most sessions; see migration 2.sqm.
    --
    -- Declared after the audit columns rather than beside the address, because ALTER TABLE
    -- appends: a column added by migration lands at the end, and a fresh database must
    -- come out with its columns in the same order as a migrated one or verifyMigrations
    -- fails. Reading order loses to matching what the migration actually produces.
    latitude         REAL,
    longitude        REAL,
    FOREIGN KEY (project_id) REFERENCES project(id)
);

CREATE INDEX session_studio_starts_idx ON session(studio_id, starts_at, deleted_at);
CREATE INDEX session_project_idx ON session(project_id, deleted_at);

selectAll:
SELECT *
FROM session
WHERE studio_id = :studioId AND deleted_at IS NULL
ORDER BY starts_at;

selectById:
SELECT *
FROM session
WHERE id = :id AND deleted_at IS NULL;

selectByProject:
SELECT *
FROM session
WHERE project_id = :projectId AND deleted_at IS NULL
ORDER BY starts_at;

-- Half-open interval, so a day query cannot double-count a session starting at midnight.
selectBetween:
SELECT *
FROM session
WHERE studio_id = :studioId
  AND deleted_at IS NULL
  AND starts_at >= :fromInclusive
  AND starts_at < :toExclusive
ORDER BY starts_at;

selectUpcoming:
SELECT *
FROM session
WHERE studio_id = :studioId
  AND deleted_at IS NULL
  AND starts_at >= :fromInclusive
ORDER BY starts_at
LIMIT :limit;

-- See the note in Contact.sq on why upsert is INSERT OR IGNORE plus UPDATE.
insertOrIgnore:
INSERT OR IGNORE INTO session(
    id, studio_id, project_id, title, kind, status, starts_at, ends_at,
    time_zone_id, location_name, location_address, call_time, notes,
    created_at, updated_at, deleted_at, version, latitude, longitude
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE session
SET project_id       = :projectId,
    title            = :title,
    kind             = :kind,
    status           = :status,
    starts_at        = :startsAt,
    ends_at          = :endsAt,
    time_zone_id     = :timeZoneId,
    location_name    = :locationName,
    location_address = :locationAddress,
    latitude         = :latitude,
    longitude        = :longitude,
    call_time        = :callTime,
    notes            = :notes,
    updated_at       = :updatedAt,
    deleted_at       = :deletedAt,
    version          = :version
WHERE id = :id;

softDelete:
UPDATE session
SET deleted_at = :deletedAt, updated_at = :deletedAt, version = version + 1
WHERE id = :id;
