-- Version 14 to 15: where reconciliation keeps its state.
--
-- Both tables are additive and no existing table changes shape, which is what ADR 0006
-- claimed when it said sync would arrive without reshaping anything. ADR 0008 decision 7
-- corrected the detail: the outbox was built ahead of time, but nowhere was provided to
-- store the pull cursor, and nowhere to keep the work a conflict discarded.

CREATE TABLE sync_state (
    studio_id       TEXT    NOT NULL PRIMARY KEY,
    last_server_seq INTEGER NOT NULL DEFAULT 0,
    last_synced_at  INTEGER
);

CREATE TABLE sync_conflict (
    id              TEXT    NOT NULL PRIMARY KEY,
    studio_id       TEXT    NOT NULL,
    entity_table    TEXT    NOT NULL,
    entity_id       TEXT    NOT NULL,
    losing_payload  TEXT    NOT NULL,
    winning_payload TEXT    NOT NULL,
    detected_at     INTEGER NOT NULL,
    resolved_at     INTEGER,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL,
    deleted_at      INTEGER,
    version         INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX sync_conflict_studio_idx ON sync_conflict(studio_id, resolved_at);
