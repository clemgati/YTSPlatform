-- Who the studio is, on paper. One row per studio.
CREATE TABLE studio_profile (
    id                   TEXT    NOT NULL PRIMARY KEY,
    studio_id            TEXT    NOT NULL,
    name                 TEXT    NOT NULL,
    address              TEXT,
    email                TEXT,
    phone                TEXT,
    website              TEXT,
    tax_number           TEXT,
    payment_instructions TEXT,
    document_footer      TEXT,
    created_at           INTEGER NOT NULL,
    updated_at           INTEGER NOT NULL,
    deleted_at           INTEGER,
    version              INTEGER NOT NULL DEFAULT 1,
    -- Declared last because ALTER TABLE appends: migration 11 added this column, and a
    -- migrated database has it in this position.
    currency             TEXT    NOT NULL DEFAULT 'USD'
);

CREATE UNIQUE INDEX studio_profile_studio_idx ON studio_profile(studio_id);

selectForStudio:
SELECT *
FROM studio_profile
WHERE studio_id = :studioId AND deleted_at IS NULL;

insertOrIgnore:
INSERT OR IGNORE INTO studio_profile(
    id, studio_id, name, address, email, phone, website, tax_number,
    payment_instructions, document_footer, created_at, updated_at, deleted_at, version,
    currency
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE studio_profile
SET name                 = :name,
    currency             = :currency,
    address              = :address,
    email                = :email,
    phone                = :phone,
    website              = :website,
    tax_number           = :taxNumber,
    payment_instructions = :paymentInstructions,
    document_footer      = :documentFooter,
    updated_at           = :updatedAt,
    deleted_at           = :deletedAt,
    version              = :version
WHERE id = :id;
