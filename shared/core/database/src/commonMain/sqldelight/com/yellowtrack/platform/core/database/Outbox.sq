-- Pending local mutations awaiting upload.
--
-- Deliberately unused in this milestone. It exists from the first migration so that the
-- synchronisation layer arrives without a schema migration — see
-- docs/adr/0006-sync-ready-multi-tenant-schema.md.
CREATE TABLE outbox (
    id           TEXT    NOT NULL PRIMARY KEY,
    studio_id    TEXT    NOT NULL,
    entity_table TEXT    NOT NULL,
    entity_id    TEXT    NOT NULL,
    operation    TEXT    NOT NULL,
    payload      TEXT,
    queued_at    INTEGER NOT NULL,
    attempts     INTEGER NOT NULL DEFAULT 0,
    last_error   TEXT
);

CREATE INDEX outbox_studio_queued_idx ON outbox(studio_id, queued_at);

selectPending:
SELECT *
FROM outbox
WHERE studio_id = :studioId
ORDER BY queued_at
LIMIT :limit;

enqueue:
INSERT INTO outbox(id, studio_id, entity_table, entity_id, operation, payload, queued_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM outbox WHERE id = :id;

recordFailure:
UPDATE outbox
SET attempts = attempts + 1, last_error = :error
WHERE id = :id;

-- Which rows this device is still holding changes for.
--
-- Read before a pulled page is written, so an arriving row cannot overwrite work that has not
-- reached the server yet. Unbounded on purpose: a cap here would silently stop protecting the
-- oldest pending rows, which are the ones that have already failed to send.
selectPendingIdentities:
SELECT entity_table, entity_id
FROM outbox
WHERE studio_id = :studioId;

-- How much this device is still holding.
--
-- Observed rather than polled, so a write can bring the next reconciliation forward instead
-- of waiting out an interval chosen for idleness. Work sitting on one device is work only
-- that device has.
countPending:
SELECT count(*)
FROM outbox
WHERE studio_id = :studioId;

-- Rows this device has tried and failed to send.
--
-- `attempts` and `last_error` have been recorded since the outbox was written and read by
-- nothing, which is the whole problem: a rejected push keeps its entry and retries forever,
-- and while it does, every pull *skips* that row to avoid overwriting the unsent work. The
-- device and the server then stay apart, silently, for as long as the push keeps failing.
--
-- Counted rather than listed, because what a studio needs to know is that this device is
-- holding work it cannot send. Which rows is a question for whoever reads `last_error`.
countStuck:
SELECT count(*)
FROM outbox
WHERE studio_id = :studioId AND attempts > 0;
