-- Where reconciliation keeps its state. See docs/adr/0008-synchronisation-semantics.md.

-- How far this device has pulled.
--
-- The cursor is a server-assigned sequence, never a timestamp: two devices whose clocks
-- disagree produce rows that fall behind a timestamp cursor that has already passed them,
-- and those rows are never pulled again. The loss is silent and permanent, which is the
-- failure ADR 0008 decision 1 exists to rule out.
--
-- One row per studio, and this table alone never leaves the device — a cursor is a fact
-- about this phone, not about the studio.
CREATE TABLE sync_state (
    studio_id       TEXT    NOT NULL PRIMARY KEY,
    last_server_seq INTEGER NOT NULL DEFAULT 0,
    last_synced_at  INTEGER
);
selectCursor:
SELECT *
FROM sync_state
WHERE studio_id = :studioId;

-- Upsert rather than update, because the first sync has no row to update.
rememberCursor:
INSERT OR REPLACE INTO sync_state(studio_id, last_server_seq, last_synced_at)
VALUES (?, ?, ?);

