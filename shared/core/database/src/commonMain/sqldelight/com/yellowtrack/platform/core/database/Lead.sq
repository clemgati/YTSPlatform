-- An enquiry, before it is a booking.
--
-- Carries its own name and contact details rather than requiring a contact row: someone
-- asking "how much for a wedding in June?" is not yet a client, and creating a client
-- account for every enquiry corrupts every count derived from the client list.
CREATE TABLE lead (
    id                    TEXT    NOT NULL PRIMARY KEY,
    studio_id             TEXT    NOT NULL,
    name                  TEXT    NOT NULL,
    source                TEXT    NOT NULL,
    status                TEXT    NOT NULL,
    received_at           INTEGER NOT NULL,
    email                 TEXT,
    phone                 TEXT,
    -- The strongest predictor of whether an enquiry books.
    first_response_at     INTEGER,
    service_line          TEXT,
    desired_date          TEXT,
    budget_low_minor      INTEGER,
    budget_high_minor     INTEGER,
    budget_currency       TEXT,
    referred_by           TEXT,
    lost_reason           TEXT,
    converted_project_id  TEXT,
    converted_client_id   TEXT,
    notes                 TEXT,
    created_at            INTEGER NOT NULL,
    updated_at            INTEGER NOT NULL,
    deleted_at            INTEGER,
    version               INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX lead_studio_status_idx ON lead(studio_id, status, deleted_at);
CREATE INDEX lead_received_idx ON lead(studio_id, received_at);

selectAll:
SELECT *
FROM lead
WHERE studio_id = :studioId AND deleted_at IS NULL
ORDER BY received_at DESC;

selectById:
SELECT *
FROM lead
WHERE id = :id AND deleted_at IS NULL;

selectOpen:
SELECT *
FROM lead
WHERE studio_id = :studioId
  AND deleted_at IS NULL
  AND status NOT IN ('Won', 'Lost')
ORDER BY received_at;

-- Enquiries that have never been replied to, oldest first. The queue to work from.
selectAwaitingResponse:
SELECT *
FROM lead
WHERE studio_id = :studioId
  AND deleted_at IS NULL
  AND first_response_at IS NULL
  AND status NOT IN ('Won', 'Lost')
ORDER BY received_at;

insertOrIgnore:
INSERT OR IGNORE INTO lead(
    id, studio_id, name, source, status, received_at, email, phone,
    first_response_at, service_line, desired_date, budget_low_minor,
    budget_high_minor, budget_currency, referred_by, lost_reason,
    converted_project_id, converted_client_id, notes,
    created_at, updated_at, deleted_at, version
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE lead
SET name                 = :name,
    source               = :source,
    status               = :status,
    received_at          = :receivedAt,
    email                = :email,
    phone                = :phone,
    first_response_at    = :firstResponseAt,
    service_line         = :serviceLine,
    desired_date         = :desiredDate,
    budget_low_minor     = :budgetLowMinor,
    budget_high_minor    = :budgetHighMinor,
    budget_currency      = :budgetCurrency,
    referred_by          = :referredBy,
    lost_reason          = :lostReason,
    converted_project_id = :convertedProjectId,
    converted_client_id  = :convertedClientId,
    notes                = :notes,
    updated_at           = :updatedAt,
    deleted_at           = :deletedAt,
    version              = :version
WHERE id = :id;

softDelete:
UPDATE lead
SET deleted_at = :deletedAt, updated_at = :deletedAt, version = version + 1
WHERE id = :id;

-- Re-read for synchronisation, tombstones included. See the note on Client.sq.
selectByIdForSync:
SELECT *
FROM lead
WHERE id = :id;
