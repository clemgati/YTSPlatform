-- One copy of a shoot's files, somewhere; see migration 8.sqm.
CREATE TABLE media_copy (
    id          TEXT    NOT NULL PRIMARY KEY,
    studio_id   TEXT    NOT NULL,
    session_id  TEXT    NOT NULL,
    volume_name TEXT    NOT NULL,
    kind        TEXT    NOT NULL,
    is_offsite  INTEGER NOT NULL DEFAULT 0,
    copied_at   INTEGER,
    verified_at INTEGER,
    notes       TEXT,
    created_at  INTEGER NOT NULL,
    updated_at  INTEGER NOT NULL,
    deleted_at  INTEGER,
    version     INTEGER NOT NULL DEFAULT 1,
    -- Declared last because ALTER TABLE appends: migration 12 added this column, and a
    -- migrated database has it in this position.
    volume_id   TEXT REFERENCES storage_volume(id),
    FOREIGN KEY (session_id) REFERENCES session(id)
);

CREATE INDEX media_copy_session_idx ON media_copy(session_id, deleted_at);

CREATE INDEX media_copy_volume_idx ON media_copy(volume_id, deleted_at);

selectBySession:
SELECT *
FROM media_copy
WHERE session_id = :sessionId AND deleted_at IS NULL
ORDER BY created_at;

selectById:
SELECT *
FROM media_copy
WHERE id = :id AND deleted_at IS NULL;

-- See the note in Contact.sq on why upsert is INSERT OR IGNORE plus UPDATE.
insertOrIgnore:
INSERT OR IGNORE INTO media_copy(
    id, studio_id, session_id, volume_name, kind, is_offsite, copied_at, verified_at,
    notes, created_at, updated_at, deleted_at, version, volume_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE media_copy
SET session_id  = :sessionId,
    volume_id   = :volumeId,
    volume_name = :volumeName,
    kind        = :kind,
    is_offsite  = :isOffsite,
    copied_at   = :copiedAt,
    verified_at = :verifiedAt,
    notes       = :notes,
    updated_at  = :updatedAt,
    deleted_at  = :deletedAt,
    version     = :version
WHERE id = :id;

softDelete:
UPDATE media_copy
SET deleted_at = :deletedAt, updated_at = :deletedAt, version = version + 1
WHERE id = :id;

-- What is on this drive, so a studio can answer "it died — what have I lost?".
selectByVolume:
SELECT *
FROM media_copy
WHERE volume_id = :volumeId AND deleted_at IS NULL
ORDER BY created_at;
