-- Version 10 to 11: who the studio is, on paper.
--
-- Every document the application sends carries this. Purely additive: one new table, no
-- existing column touched, so a studio migrating keeps everything it had.
CREATE TABLE studio_profile (
    id                   TEXT    NOT NULL PRIMARY KEY,
    studio_id            TEXT    NOT NULL,
    name                 TEXT    NOT NULL,
    address              TEXT,
    email                TEXT,
    phone                TEXT,
    website              TEXT,
    tax_number           TEXT,
    payment_instructions TEXT,
    document_footer      TEXT,
    created_at           INTEGER NOT NULL,
    updated_at           INTEGER NOT NULL,
    deleted_at           INTEGER,
    version              INTEGER NOT NULL DEFAULT 1
);

-- One profile per studio, like codb_profile. Enforced here rather than in code so a
-- second row cannot appear through a sync conflict and leave two names on two documents.
CREATE UNIQUE INDEX studio_profile_studio_idx ON studio_profile(studio_id);
