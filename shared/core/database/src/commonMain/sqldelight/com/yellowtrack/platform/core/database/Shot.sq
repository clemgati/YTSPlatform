-- A photograph promised for a session.
--
-- Grouped, because family formals are worked a group at a time; see migration 3.sqm.
CREATE TABLE shot (
    id            TEXT    NOT NULL PRIMARY KEY,
    studio_id     TEXT    NOT NULL,
    session_id    TEXT    NOT NULL,
    description   TEXT    NOT NULL,
    group_name    TEXT,
    people        TEXT,
    position      INTEGER NOT NULL DEFAULT 0,
    is_captured   INTEGER NOT NULL DEFAULT 0,
    captured_at   INTEGER,
    notes         TEXT,
    created_at    INTEGER NOT NULL,
    updated_at    INTEGER NOT NULL,
    deleted_at    INTEGER,
    version       INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (session_id) REFERENCES session(id)
);

CREATE INDEX shot_session_idx ON shot(session_id, deleted_at, position);

selectBySession:
SELECT *
FROM shot
WHERE session_id = :sessionId AND deleted_at IS NULL
ORDER BY position, created_at;

selectById:
SELECT *
FROM shot
WHERE id = :id AND deleted_at IS NULL;

-- See the note in Contact.sq on why upsert is INSERT OR IGNORE plus UPDATE.
insertOrIgnore:
INSERT OR IGNORE INTO shot(
    id, studio_id, session_id, description, group_name, people, position,
    is_captured, captured_at, notes, created_at, updated_at, deleted_at, version
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE shot
SET session_id  = :sessionId,
    description = :description,
    group_name  = :groupName,
    people      = :people,
    position    = :position,
    is_captured = :isCaptured,
    captured_at = :capturedAt,
    notes       = :notes,
    updated_at  = :updatedAt,
    deleted_at  = :deletedAt,
    version     = :version
WHERE id = :id;

softDelete:
UPDATE shot
SET deleted_at = :deletedAt, updated_at = :deletedAt, version = version + 1
WHERE id = :id;

-- Re-read for synchronisation, tombstones included. See the note on Client.sq.
selectByIdForSync:
SELECT *
FROM shot
WHERE id = :id;
