-- Migration 3 → 4: shot lists.
--
-- Adds the shots promised for a session. The table exists rather than a notes field
-- because of the family formals at a wedding: twenty combinations of relatives, half of
-- whom wander off between groups, and one combination that will be remembered for thirty
-- years if it is missed.
--
-- Grouping is the point. A photographer works a group at a time and releases people once
-- their group is done; a list that cannot be grouped keeps forty people standing in a
-- field.
--
-- Purely additive. A new table, so every row a studio already has is untouched.
--
-- These statements must produce exactly the schema the .sq files describe; the
-- verifyMigrations task compares the two and fails the build if they diverge.

CREATE TABLE shot (
    id            TEXT    NOT NULL PRIMARY KEY,
    studio_id     TEXT    NOT NULL,
    session_id    TEXT    NOT NULL,
    description   TEXT    NOT NULL,
    group_name    TEXT,
    people        TEXT,
    position      INTEGER NOT NULL DEFAULT 0,
    is_captured   INTEGER NOT NULL DEFAULT 0,
    captured_at   INTEGER,
    notes         TEXT,
    created_at    INTEGER NOT NULL,
    updated_at    INTEGER NOT NULL,
    deleted_at    INTEGER,
    version       INTEGER NOT NULL DEFAULT 1,
    FOREIGN KEY (session_id) REFERENCES session(id)
);

CREATE INDEX shot_session_idx ON shot(session_id, deleted_at, position);
