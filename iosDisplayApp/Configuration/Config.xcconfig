TEAM_ID=

PRODUCT_NAME=yellow-track-display
// A different identifier from the studio application, deliberately: a studio may have both
// on one iPad — the one it works from and the one on the table — and two applications
// sharing an identifier cannot coexist.
PRODUCT_BUNDLE_IDENTIFIER=com.yellowtrack.platform.display$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// The Shared framework is static and uses SQLDelight's NativeSqliteDriver, which
// calls into the system SQLite. A static framework does not bundle those symbols,
// so the app link step must pull in libsqlite3 or every sqlite3_* symbol is undefined.
OTHER_LDFLAGS=$(inherited) -lsqlite3
